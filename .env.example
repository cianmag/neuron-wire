# ─── Neuron Wire Docker Compose — Environment Variables ────────────
# Copy this file to .env and edit as needed.
# All variables have sensible defaults; uncomment to override.
# ───────────────────────────────────────────────────────────────────

# ── NWP Node ──────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error
# RUST_LOG=info

# UDP port exposed to the host for peer connections
# NWP_PORT=9000

# HTTP port exposed to the host for health/metrics/dashboard
# NWP_HTTP_PORT=9100

# Container resource limits
# NWP_MEMORY_LIMIT=512M
# NWP_CPU_LIMIT=1.0

# ── Prometheus ─────────────────────────────────────────────────────
# Host port for the Prometheus web UI
# PROMETHEUS_PORT=9090

# How long to retain metrics data (e.g. 15d, 30d, 90d)
# PROM_RETENTION=15d

# ── Grafana ────────────────────────────────────────────────────────
# Host port for the Grafana web UI
# GRAFANA_PORT=3000

# Admin credentials (CHANGE THESE for any non-localhost deployment)
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=nwp-admin

# Public URL where Grafana is accessible (for email links, OAuth redirects)
# GRAFANA_ROOT_URL=http://localhost:3000
