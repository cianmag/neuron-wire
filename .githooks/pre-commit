#!/usr/bin/env bash
# ── Pre-commit hook: enforce zero warnings + formatting ──────────
# Install with:  git config core.hooksPath .githooks
#
# On Windows (git-bash / MINGW), clippy checks lib only because
# test targets transitively depend on windows-sys which needs
# dlltool.exe (unavailable in git-bash).
# ──────────────────────────────────────────────────────────────────

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
PASS=0
FAIL=0

check() {
    local name="$1"
    shift
    echo -n "  🔍 $name ... "
    if "$@" 2>/dev/null; then
        echo -e "${GREEN}OK${NC}"
        PASS=$((PASS + 1))
    else
        echo -e "${RED}FAILED${NC}"
        FAIL=$((FAIL + 1))
    fi
}

# ── Detect platform ──────────────────────────────────────────────
IS_WINDOWS=false
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=true ;;
esac

echo ""
echo "┌──────────────────────────────────────┐"
echo "│  Pre-commit checks (neuron-wire)      │"
echo "└──────────────────────────────────────┘"
echo ""

# 1. Formatting (always)
check "cargo fmt --check" cargo fmt --check

# 2. Clippy (lib only on Windows, all-targets otherwise)
if $IS_WINDOWS; then
    check "cargo clippy --lib -D warnings" cargo clippy --lib -- -D warnings
else
    check "cargo clippy --all-targets -D warnings" cargo clippy --all-targets -- -D warnings
fi

# ── Summary ──────────────────────────────────────────────────────
echo ""
if [ $FAIL -eq 0 ]; then
    echo -e "${GREEN}✓ All $PASS checks passed.${NC}"
    echo ""
    exit 0
else
    echo -e "${RED}✗ $FAIL check(s) failed — fix before committing.${NC}"
    echo ""
    exit 1
fi
